# mem0-mcp-selfhosted environment variables
# Copy to .env and fill in values. Never commit .env with real secrets.

# --- LLM Provider ---
# MEM0_LLM_PROVIDER=anthropic          # anthropic | ollama | openai
# MEM0_LLM_MODEL=claude-opus-4-6       # Model name (default depends on provider; required for openai)
# MEM0_LLM_MAX_TOKENS=16384
# MEM0_LLM_URL=http://localhost:11434   # Base URL: Ollama URL or any OpenAI-compatible endpoint

# --- Anthropic Auth (pick one) ---
# MEM0_ANTHROPIC_TOKEN=               # OAuth/OAT token (highest priority)
# ANTHROPIC_API_KEY=                   # Standard API key (fallback)

# --- OpenAI-Compatible Server Auth ---
# MEM0_OPENAI_API_KEY=not-needed      # API key for OpenAI-compat servers (e.g. "lm-studio", "not-needed")

# --- Embedder ---
# MEM0_EMBED_PROVIDER=ollama           # ollama | openai
# MEM0_EMBED_MODEL=bge-m3
# MEM0_EMBED_URL=http://localhost:11434
# MEM0_EMBED_DIMS=1024

# --- Vector Store (Qdrant) ---
# MEM0_QDRANT_URL=http://localhost:6333
# MEM0_COLLECTION=mem0_mcp_selfhosted
# MEM0_QDRANT_API_KEY=
# MEM0_QDRANT_ON_DISK=false

# Graph memory was removed in v0.4 (mem0 v3 migration). MEM0_ENABLE_GRAPH,
# MEM0_NEO4J_*, MEM0_GRAPH_*, and GOOGLE_API_KEY for graph are no-ops; setting
# them logs a one-time warning. See CHANGELOG.md.

# --- Server ---
# MEM0_HOST=0.0.0.0
# MEM0_PORT=8081
# MEM0_TRANSPORT=stdio                 # stdio | sse | streamable-http
# MEM0_LOG_LEVEL=INFO

# --- Memory Defaults ---
# MEM0_USER_ID=default
# MEM0_HISTORY_DB_PATH=
